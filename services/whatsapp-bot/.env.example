# Authorized Phone Numbers (E.164 format without + or with 62)
AEGG_PHONE="62895416185355"
PEPPAA_PHONE="6285717917058"
PEPPAA_PHONE_2="6289528371422"
BOT_PHONE="6285117200792"

# WhatsApp Group JID (Optional, auto-registered on !setgroup)
COUPLE_GROUP_JID=""

# Storage Paths
